# CODING 8 (USER-DEFINED FUNCTIONS FOR STRING OPERATION)
def string_length(s):
    return len(s)

def to_upper(s):
    return s.upper()

def to_lower(s):
    return s.lower()

def reverse_string(s):
    return s[::-1]

text = input("Enter a string:")

print("Length of the string:", string_length(text))
print("Upper case:", to_upper(text))
print("Lower case:", to_lower(text))
print("Reversed String:", reverse_string(text))
